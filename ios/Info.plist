<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nearby servers: the Bonjour services iOS lets the app browse (the rest of Info.plist is generated). -->
	<key>NSBonjourServices</key>
	<array>
		<string>_ssh._tcp</string>
		<string>_sftp-ssh._tcp</string>
	</array>
	<!-- The Files tab's "On iPhone" side (the app's Documents folder) shows in the Files app too: On My iPhone ▸ AirSCP. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
