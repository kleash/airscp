<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store version (build.sh with its App Store option): App Sandbox, with what AirSCP needs and nothing more.
     network.client: ssh, scp, sftp, S3 storage and Remote Desktop connect out. network.server: tunnels listen on this
     Mac's ports.
     files.user-selected.read-write: folders and files the person picks in an Open panel or drags in (the SSH folder,
     Mac folders, imports). files.bookmarks.app-scope: AirSCP keeps those choices for the next launch.
     files.downloads.read-write: downloads land in the Downloads folder by default, and the Remote Desktop's shared
     folder is in it, so they work before anything is chosen.
     ssh, scp, sftp and AirSCP's own helpers (askpass, the proxy helper, the agent bridge) run inside the same sandbox. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
