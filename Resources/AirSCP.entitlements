<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The release's signature (scripts/release-local.sh) with the hardened runtime. The only entitlement it needs: AirSCP
     asks iTerm through osascript for a window with the ssh session, and the hardened runtime refuses Apple Events
     without it (NSAppleEventsUsageDescription in AirSCP-Info.plist is the question macOS then asks). Network
     entitlements are for sandboxed apps only; this build isn't sandboxed (the App Store build of PLAN.md AB is). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
